{
    "name": "gd-companion",
    "productName": "Grim Dawn AI Companion",
    "version": "1.1.0",
    "private": true,
    "type": "module",
    "description": "macOS-native companion tool for Grim Dawn: save parsing, item DB, AI gear advice",
    "scripts": {
        "cli": "tsx src/cli/index.ts",
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "dist": "npm run build && electron-builder --mac",
        "dist:win": "npm run build && electron-builder --win",
        "dist:all": "npm run build && electron-builder --mac --win",
        "start": "electron-vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/renderer/tsconfig.json",
        "storybook": "storybook dev -p 6006 --no-open",
        "storybook:build": "storybook build -o out/storybook",
        "stories:shoot": "node scripts/shoot-stories.mjs",
        "stories:check": "node scripts/check-stories.mjs",
        "app:check": "npm run build && env -u ELECTRON_RUN_AS_NODE node scripts/check-app.mjs"
    },
    "dependencies": {
        "commander": "^14.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@floating-ui/react": "^0.27.20",
        "@fontsource-variable/inter": "^5.3.0",
        "@grimdawn/core": "file:../grimdawn-core",
        "@storybook/react-vite": "^10.5.7",
        "@types/node": "^24.3.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^5.2.0",
        "electron": "^38.8.6",
        "electron-builder": "^26.15.3",
        "electron-vite": "^4.0.1",
        "playwright": "^1.62.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "storybook": "^10.5.7",
        "tsx": "^4.20.5",
        "typescript": "^5.9.2",
        "vite": "^7.3.6",
        "vitest": "^3.2.4"
    },
    "main": "out/main/index.cjs"
}
